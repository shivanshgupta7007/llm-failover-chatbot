# Comma-separated pool of LLM API keys (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key

# LiteLLM model name used for every request.
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Extra models tried, in order, if every key fails on the primary model.
LLM_FALLBACK_MODELS=gemini/gemini-3.1-flash-lite,gemini/gemini-3.8-flash,gemini/gemini-3.6-flash

# SQLite location; the /data directory is a Docker volume in docker-compose.
DATABASE_URL=sqlite:////data/app.db

# Directory for LiteLLM's disk cache.
LITELLM_CACHE_DIR=/data/litellm-cache

# Comma-separated CORS origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure failover test hook on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# Optional: default system prompt when the client does not set one.
DEFAULT_SYSTEM_PROMPT=You are a concise, helpful assistant.
